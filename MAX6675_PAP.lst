01C1:  MOVF   21,W
01C2:  BSF    03.5
01C3:  MOVWF  07
01C4:  BCF    03.5
01C5:  BCF    07.4
....................    output_high(TC_CS);            //if we idle high, the chip keeps doing conversions. Change this if you like  
01C6:  BCF    21.0
01C7:  MOVF   21,W
01C8:  BSF    03.5
01C9:  MOVWF  07
01CA:  BCF    03.5
01CB:  BSF    07.0
.................... }  
....................  
