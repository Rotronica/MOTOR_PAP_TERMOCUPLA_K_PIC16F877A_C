#include <stdint.h>     //Libreria para hacer uso de los tipos de datos uint8_t, uint16_t, etc.
#define PERIODO_FREC_PAP  35 //Periodo de la frecuencia de motor PAP A 35ms
//Vector con dimension de 4 que contiene la secuencia de paso doble
static const uint8_t paso_doble[4] ={0b1100, //Secuencia 1
                                     0b0110, //Secuencia 2
                                     0b0011, //Secuencia 3
                                     0b1001};//Secuencia 4
//Funcion para el giro horario del motor PAP                                    
void giro_horario(void){
   for(uint8_t i =0; i<4; i++){ //Bucle for para tomar los datos de nuestro vector
      output_b(paso_doble[i]);   //Toma la secuencia del vector y lo refleja al puertos B
      delay_ms(PERIODO_FREC_PAP);//Retardo para la velocidad del motor PAP
   }
}
//Funcion para configurar registros como entradas o salidas
void setup(void){
   set_tris_b(0x00); //Coloca todo el puerto B como salida
   output_b(0x00);   //Limpia el puertos B
}
void main() 
{ 
   float Temperatura;   //Variable global
   lcd_init();
   lcd_putc("\f");
   lcd_gotoxy(1,1);
   lcd_putc("Temperatura");
   while(true){ 
      Temperatura = do_everything();
      lcd_gotoxy(1,2);
      printf(lcd_putc, "T:%3.2fC",Temperatura);
      if(temperatura > 70){
         giro_horario();
      }
   } 
} 
